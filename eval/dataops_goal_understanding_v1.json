{
  "version": "dataops-goal-understanding-dev-v1",
  "kind": "author_written_known_synthetic_development_not_holdout",
  "frozen_before_model_execution": true,
  "defaults": {
    "attributes": [
      "medicinal_part",
      "latin_name"
    ],
    "document_fields": [
      "功能与主治",
      "注意"
    ],
    "completion_policy": "audit",
    "named_query_limit": 50,
    "filter_query_default_limit": 20
  },
  "reference_policy": "Exact normalized object set, query scope, output field sets, completion policy and revision intent. Ambiguous/unsupported whole requests must not execute partially. A delivery that correctly reports missing data may complete under audit. No clinical truth claims.",
  "cases": [
    {
      "case_id": "C01",
      "category": "control",
      "question": "整理Alpha的功效、注意，保留出处并生成表格",
      "expected_status": "ready",
      "expected_goal": {
        "query": {
          "names": [
            "Alpha"
          ],
          "limit": 50
        }
      },
      "expected_names": [
        "Alpha"
      ],
      "parent_goal": null
    },
    {
      "case_id": "C02",
      "category": "control",
      "question": "整理Beta的贮藏，保留出处",
