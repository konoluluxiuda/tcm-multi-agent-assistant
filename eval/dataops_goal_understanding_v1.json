      "expected_goal": {
        "query": {
          "names": [
            "Beta"
          ],
          "limit": 50
        },
        "document_fields": [
          "贮藏"
        ]
      },
      "expected_names": [
        "Beta"
      ],
      "parent_goal": null
    },
    {
      "case_id": "C03",
      "category": "control",
      "question": "整理药用部位包含Root的前2条记录的功效",
      "expected_status": "ready",
      "expected_goal": {
        "query": {
          "filters": [
            {
              "field": "medicinal_part",
              "op": "contains",
              "value": "Root"
